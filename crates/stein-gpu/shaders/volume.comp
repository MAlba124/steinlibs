#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_nonuniform_qualifier : require

// Test kernel for volumes: sample a texture3D slot with the linear clamp
// sampler at each point, write what it gave. Points and results are
// vec4s behind pointers in the root.

layout(local_size_x = 8) in;

layout(buffer_reference, std430, buffer_reference_align = 16) buffer Vec4s {
    vec4 v[];
};

// Mirrors the test's VolumeRoot, 24 bytes.
layout(push_constant, std430) uniform Root {
    Vec4s points;
    Vec4s values;
    uint slot;
    uint count;
} root;

// The global set: samplers, texture2D[] at 1, texture3D[] at 2.
layout(set = 0, binding = 0) uniform sampler samplers[4];
layout(set = 0, binding = 2) uniform texture3D volumes[];

const uint LINEAR_CLAMP = 1u; // stein_gpu::Sampler::LinearClamp

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= root.count) {
        return;
    }
    vec3 p = root.points.v[i].xyz;
    root.values.v[i] = textureLod(sampler3D(volumes[root.slot], samplers[LINEAR_CLAMP]), p, 0.0);
}
